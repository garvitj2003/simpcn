{
  "name": "@simpcn/next",
  "version": "0.1.2",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./assets": {
      "import": {
        "types": "./dist/assets.d.ts",
        "default": "./dist/assets.js"
      },
      "require": {
        "types": "./dist/assets.d.cts",
        "default": "./dist/assets.cjs"
      }
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simpcn/core": "workspace:*",
    "@simpcn/transforms-js": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.4.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "description": "Next.js integration for verified public assets with Turbopack and webpack.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garvitj2003/simpcn.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/garvitj2003/simpcn#readme",
  "bugs": {
    "url": "https://github.com/garvitj2003/simpcn/issues"
  },
  "author": "Garvit jain"
}
