{
  "name": "@simpcn/transforms",
  "version": "0.1.1",
  "type": "module",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "dist/THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/bundle-package.mjs transforms",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simpcn/core": "workspace:*",
    "@simpcn/transforms-js": "workspace:*",
    "magic-string": "^1.4.3"
  },
  "description": "Shared parser-based asset URL transformations for simpcn framework adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garvitj2003/simpcn.git",
    "directory": "packages/transforms"
  },
  "homepage": "https://github.com/garvitj2003/simpcn#readme",
  "bugs": {
    "url": "https://github.com/garvitj2003/simpcn/issues"
  },
  "author": "Garvit jain",
  "devDependencies": {
    "parse5": "^8.0.1",
    "postcss": "^8.5.29",
    "postcss-value-parser": "^4.2.0"
  }
}
